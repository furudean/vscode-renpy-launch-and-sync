{
	"name": "renpyWarp",
	"displayName": "Ren'Py Launch and Sync",
	"description": "Keep Ren'Py in sync with your code",
	"version": "4.0.0",
	"publisher": "PaisleySoftworks",
	"icon": "images/eileen.png",
	"engines": {
		"vscode": "^1.101.0",
		"node": ">=22.18"
	},
	"keywords": [
		"renpy"
	],
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/furudean/vscode-renpy-warp.git"
	},
	"activationEvents": [
		"onLanguage:renpy",
		"workspaceContains:**/*.rpy",
		"onDebugResolve:renpyWarp",
		"onDebugDynamicConfigurations:renpyWarp"
	],
	"type": "commonjs",
	"main": "./dist/extension.js",
	"extensionDependencies": [
		"mindaro-dev.file-downloader"
	],
	"scripts": {
		"vscode:prepublish": "node esbuild.js --production",
		"publish": "echo 'use `npm run publish:vsce` or `npm run publish:ovsx` instead'",
		"publish:vsce": "vsce publish",
		"publish:ovsx": "ovsx publish",
		"compile": "npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "vsce package",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "tsc --noEmit",
		"lint": "npm run check-types && eslint && prettier --check .",
		"format": "prettier --write .",
		"test:unit": "node --test \"src/**/*.unit.test.ts\"",
		"pretest:extension": "npm run compile-tests && node esbuild.js",
		"test:extension": "vscode-test",
		"test": "npm run test:unit && npm run test:extension"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/adm-zip": "^0.5.5",
		"@types/jsdom": "^30.0.0",
		"@types/mocha": "^10.0.7",
		"@types/node": "^22.17.0",
		"@types/semver": "^7.5.8",
		"@types/split2": "^4.2.3",
		"@types/vscode": "^1.87.0",
		"@types/ws": "^8.5.12",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.1.1",
		"esbuild": "^0.28.2",
		"esbuild-plugin-copy": "^2.1.1",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.0.0",
		"npm-run-all": "^4.1.5",
		"ovsx": "^1.2.0",
		"prettier": "^3.8.1",
		"split2": "^4.2.0",
		"typescript": "^5.5.4",
		"typescript-eslint": "^8.8.0"
	},
	"dependencies": {
		"@logdna/tail-file": "^4.0.2",
		"@microsoft/vscode-file-downloader-api": "^1.0.1",
		"@vscode/debugadapter": "^1.68.0",
		"@vscode/debugprotocol": "^1.68.0",
		"adm-zip": "^0.6.1",
		"env-paths": "^4.0.0",
		"extract-zip": "^2.0.1",
		"find-process": "^2.0.0",
		"get-port": "^7.1.0",
		"jsdom": "^29.1.1",
		"memoize": "^11.0.0",
		"open": "^11.0.0",
		"p-filter": "^4.1.0",
		"p-locate": "^7.0.0",
		"semver": "^7.6.3",
		"sort-paths": "^1.1.1",
		"tildify": "^3.0.0",
		"tree-kill": "^1.2.2",
		"untildify": "^6.0.0",
		"upath": "^3.0.8",
		"url-join": "^5.0.0",
		"ws": "^8.18.0"
	},
	"contributes": {
		"debuggers": [
			{
				"type": "renpyWarp",
				"label": "Ren'Py Launch and Sync",
				"languages": [
					"renpy"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"project": {
								"type": "string",
								"description": "Path to the Ren'Py project root (the folder containing game/). Detected from `file` or prompted for when omitted."
							},
							"file": {
								"type": "string",
								"description": "Script to open at. Absolute, or relative to `project`."
							},
							"line": {
								"type": [
									"number",
									"string"
								],
								"description": "1-indexed line in `file` to warp to. When omitted with `file` set, the first playable statement in the file is used."
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"default": [],
								"description": "Extra arguments appended to the Ren'Py command line."
							},
							"env": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"default": {},
								"description": "Extra environment variables for the Ren'Py process. Merged after renpyWarp.processEnvironment."
							},
							"sdk": {
								"type": "string",
								"description": "Ren'Py SDK to run with, overriding the project's .renpy-version. Either a version the extension manages, such as \"8.3.7\", which is offered for download when it isn't installed, or a path to an SDK directory."
							}
						}
					},
					"attach": {
						"required": [
							"pid"
						],
						"properties": {
							"pid": {
								"type": "number",
								"description": "PID of a Ren'Py process the extension is already tracking."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "renpyWarp",
						"request": "launch",
						"name": "Launch Ren'Py project"
					}
				],
				"configurationSnippets": [
					{
						"label": "Ren'Py Launch and Sync: Launch project",
						"description": "Start the Ren'Py project in the workspace",
						"body": {
							"type": "renpyWarp",
							"request": "launch",
							"name": "Launch Ren'Py project"
						}
					},
					{
						"label": "Ren'Py Launch and Sync: Open at current line",
						"description": "Start Ren'Py warped to the line under the cursor",
						"body": {
							"type": "renpyWarp",
							"request": "launch",
							"name": "Open Ren'Py at current line",
							"file": "^\"\\${file}\"",
							"line": "^\"\\${lineNumber}\""
						}
					}
				]
			}
		],
		"colors": [
			{
				"id": "renpyWarp.dialogueBackgroundDecoration",
				"description": "Background of the dialogue Ren'Py is at",
				"defaults": {
					"dark": "editor.inactiveSelectionBackground",
					"light": "editor.inactiveSelectionBackground",
					"highContrast": "editor.inactiveSelectionBackground"
				}
			}
		],
		"icons": {
			"warp-renpy": {
				"description": "Ren'Py Icon",
				"default": {
					"fontPath": "assets/warp.woff",
					"fontCharacter": "\\ea01"
				}
			}
		},
		"commands": [
			{
				"command": "renpyWarp.launch",
				"title": "Launch Ren'Py project",
				"category": "Ren'Py Launch",
				"icon": "$(play)"
			},
			{
				"command": "renpyWarp.warpToLine",
				"title": "Open Ren'Py to line",
				"category": "Ren'Py Launch",
				"icon": "$(play)"
			},
			{
				"command": "renpyWarp.warpToFile",
				"title": "Open Ren'Py to file",
				"category": "Ren'Py Launch",
				"icon": "$(play)"
			},
			{
				"command": "renpyWarp.jumpToLabel",
				"title": "Open Ren'Py at label",
				"category": "Ren'Py Launch",
				"icon": "$(play)",
				"enablement": "renpyWarp.renpyExtensionsEnabled"
			},
			{
				"command": "renpyWarp.killAll",
				"title": "Kill active Ren'Py instances",
				"category": "Ren'Py Launch",
				"enablement": "renpyWarp.runningProcesses > 0"
			},
			{
				"command": "renpyWarp.toggleFollowCursor",
				"title": "Toggle following cursor mode",
				"category": "Ren'Py Launch",
				"enablement": "renpyWarp.renpyExtensionsEnabled"
			},
			{
				"command": "renpyWarp.syncCursorPosition",
				"title": "Go to to current Ren'Py line",
				"category": "Ren'Py Launch",
				"enablement": "renpyWarp.runningProcesses > 0"
			},
			{
				"command": "renpyWarp.installRpe",
				"title": "Install Ren'Py extensions (.rpe)",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.uninstallRpe",
				"title": "Uninstall Ren'Py extensions (.rpe)",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.setSdkPath",
				"title": "Set Ren'Py SDK",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.setExtensionsPreference",
				"title": "Set Ren'Py extensions preference",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.startSocketServer",
				"title": "Start socket server",
				"category": "Ren'Py Launch",
				"enablement": "!renpyWarp.socketServerRunning"
			},
			{
				"command": "renpyWarp.stopSocketServer",
				"title": "Stop socket server",
				"category": "Ren'Py Launch",
				"enablement": "renpyWarp.socketServerRunning"
			},
			{
				"command": "renpyWarp.resetSuppressedMessages",
				"title": "Reset suppressed notifications",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.launchSDK",
				"title": "Open the Ren'Py launcher",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.lint",
				"title": "Lint project",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.rmpersistent",
				"title": "Delete persistent data",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.forceRecompile",
				"title": "Force Recompile",
				"category": "Ren'Py Launch"
			},
			{
				"command": "renpyWarp.resetWorkspaceState",
				"title": "Reset Workspace State",
				"category": "Ren'Py Launch"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "renpyWarp.warpToLine",
					"when": "resourceExtname == '.rpy'"
				},
				{
					"command": "renpyWarp.warpToFile",
					"when": "resourceExtname == '.rpy'"
				}
			],
			"editor/context": [
				{
					"command": "renpyWarp.warpToLine",
					"group": "renpywarp",
					"when": "resourceExtname == '.rpy'"
				}
			],
			"editor/lineNumber/context": [
				{
					"command": "renpyWarp.warpToLine",
					"group": "renpywarp",
					"when": "resourceExtname == '.rpy'"
				}
			],
			"explorer/context": [
				{
					"command": "renpyWarp.warpToFile",
					"group": "renpywarp",
					"when": "resourceExtname == '.rpy'"
				}
			]
		},
		"keybindings": [
			{
				"command": "renpyWarp.launch",
				"key": "alt+shift+l",
				"mac": "cmd+shift+l"
			},
			{
				"command": "renpyWarp.warpToLine",
				"key": "alt+shift+e",
				"mac": "cmd+shift+e",
				"when": "editorTextFocus && resourceExtname == '.rpy'"
			},
			{
				"command": "renpyWarp.warpToFile",
				"key": "alt+shift+f",
				"mac": "cmd+shift+f",
				"when": "editorTextFocus && resourceExtname == '.rpy'"
			},
			{
				"command": "renpyWarp.jumpToLabel",
				"key": "alt+shift+j",
				"mac": "cmd+shift+j"
			},
			{
				"command": "renpyWarp.killAll",
				"key": "alt+shift+k",
				"mac": "cmd+shift+k"
			},
			{
				"command": "renpyWarp.toggleFollowCursor",
				"key": "alt+shift+c",
				"mac": "cmd+shift+c"
			},
			{
				"command": "renpyWarp.syncCursorPosition",
				"key": "ctrl+shift+e",
				"mac": "alt+shift+e"
			}
		],
		"configuration": {
			"title": "Ren'Py Launch and Sync",
			"properties": {
				"renpyWarp.strategy": {
					"type": "string",
					"default": "Update Window",
					"markdownDescription": "How to treat an existing Ren'Py instance when a warping command is issued",
					"order": 1,
					"enum": [
						"Update Window",
						"New Window",
						"Replace Window"
					],
					"markdownEnumDescriptions": [
						"Execute `renpy.warp_to_line()` in the open instance.\n\n**Note**: This setting is is ignored if `#renpyWarp.renpyExtensionsEnabled#` is enabled.",
						"Launch a new instance when a command is executed.",
						"Kill the existing instance and launch a new one."
					]
				},
				"renpyWarp.renpyExtensionsEnabled": {
					"type": "string",
					"enum": [
						"Not set",
						"Enabled",
						"Disabled"
					],
					"default": "Not set",
					"markdownDescription": "Enable Ren'Py Extension (.rpe) support",
					"order": 1,
					"scope": "machine-overridable"
				},
				"renpyWarp.autoConnectExternalProcesses": {
					"type": "string",
					"enum": [
						"Ask",
						"Always connect",
						"Never connect"
					],
					"default": "Ask",
					"markdownDescription": "What to do when a process launched outside of Ren'Py is detected",
					"order": 2
				},
				"renpyWarp.followCursorMode": {
					"type": "string",
					"order": 2,
					"markdownDescription": "When in _Follow Cursor_ mode, what should be kept in sync?",
					"default": "Ren'Py updates Visual Studio Code",
					"enum": [
						"Ren'Py updates Visual Studio Code",
						"Visual Studio Code updates Ren'Py",
						"Update both"
					],
					"markdownEnumDescriptions": [
						"Editor will sync with current line in Ren'Py.",
						"Ren'Py will sync with current line in the editor.",
						"Try and keep both in sync."
					]
				},
				"renpyWarp.followCursorBehavior": {
					"type": "string",
					"order": 2.1,
					"markdownDescription": "While in _Follow Cursor_ mode, where to put your cursor when Ren'Py moves.",
					"default": "Just reveal",
					"enum": [
						"Just reveal",
						"Select dialogue",
						"Cursor at dialogue end",
						"Cursor at line end"
					],
					"markdownEnumDescriptions": [
						"Reveal the line of dialogue being shown, leaving your cursor alone.",
						"Select the dialogue being said.",
						"Place the cursor where the dialogue ends.",
						"Place the cursor at the end of the line."
					]
				},
				"renpyWarp.followCursorOnLaunch": {
					"type": "boolean",
					"default": false,
					"order": 2.2,
					"markdownDescription": "Automatically enter _Follow Cursor_ mode when launching Ren'Py. This is ignored if `#renpyWarp.renpyExtensionsEnabled#` is set to _Disabled_."
				},
				"renpyWarp.setAutoReloadOnSave": {
					"type": "boolean",
					"default": false,
					"order": 3,
					"markdownDescription": "Enable autoreload in the Ren'Py process when a file is saved"
				},
				"renpyWarp.autoStartSocketServer": {
					"type": "boolean",
					"default": true,
					"order": 3,
					"markdownDescription": "Automatically start the socket server when in a Ren'Py project"
				},
				"renpyWarp.showDialogueDecorations": {
					"type": "boolean",
					"default": true,
					"order": 3,
					"markdownDescription": "Highlight the dialogue Ren'Py is at.\n\nStyled by `renpyWarp.dialogueBackgroundDecoration`."
				},
				"renpyWarp.showGutterDecorations": {
					"type": "boolean",
					"default": true,
					"order": 3,
					"markdownDescription": "Show a gutter icon on the line Ren'Py is on"
				},
				"renpyWarp.exclude": {
					"type": "array",
					"markdownDescription": "Additional [VSCode glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to exclude when searching for Ren'Py projects. These are relative to your workspace.\n\nAutomatically includes `#files.exclude#`.",
					"default": [],
					"items": {
						"type": "string"
					},
					"examples": [
						[
							"out/**"
						]
					],
					"order": 3
				},
				"renpyWarp.editor": {
					"type": "string",
					"default": "launcher/Visual Studio Code (System).edit.py",
					"markdownDescription": "The `Editor` class to supply to `renpy.sh`. Should be a relative or absolute path to an `.edit.py` file.\n\nThis setting is equivalent to the environment variable [`RENPY_EDIT_PY`](https://www.renpy.org/doc/html/editor.html).\n\nRelative paths are resolved from the SDK path. For example, a valid value would be [`launcher/System Editor.edit.py`](https://github.com/renpy/renpy/blob/master/launcher/System%20Editor.edit.py).\n\n"
				},
				"renpyWarp.processEnvironment": {
					"type": "object",
					"markdownDescription": "Additional environment variables to pass to the Ren'Py process.",
					"default": {},
					"additionalProperties": {
						"type": "string"
					}
				}
			}
		}
	}
}
